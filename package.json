{
  "name": "obsidian-miauwi",
  "version": "1.0.0",
  "description": "Una mascota académica local para Obsidian, con nombre personalizable.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "test-vault": "npm run build && node scripts/test-vault.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "luxon": "^3.7.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
